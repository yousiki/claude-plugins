	"license": "MIT",
	"lspServers": {
		"liquid": {
			"command": "${CLAUDE_PLUGIN_ROOT}/scripts/launch-liquid-lsp.sh",
			"extensionToLanguage": {
				".liquid": "liquid"
			}
		}
	}
}
